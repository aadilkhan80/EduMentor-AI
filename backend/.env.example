# EduMentor AI Backend Environment Variables
PROJECT_NAME="EduMentor AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="generate_a_unique_secret_at_least_32_characters_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration (pg8000 driver)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="edumentor_db"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password"

# Weak Area Detection Config
WEAK_TOPIC_THRESHOLD=60.0

# LLM / AI Configuration (Never hardcode secrets!)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="optional_openai_api_key_here"
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
